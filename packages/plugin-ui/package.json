{
  "name": "@ccgui/plugin-ui",
  "version": "0.1.0",
  "description": "CC GUI 插件共享 UI 组件库：插件把组件 bundle 进自己的产物（与插件同一棵 React 树），样式全部消费宿主语义 token 并带 fallback。纯新增、插件按需引入，不影响未使用的插件。",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.ts",
    "./styles.css": "./styles.css"
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "typescript": "^5.6.2"
  }
}
